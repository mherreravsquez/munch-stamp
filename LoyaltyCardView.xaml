<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="munch_stamp.Controls.LoyaltyCardView"
             WidthRequest="600" HeightRequest="840">
    <Grid>
        <!-- Shadow layer -->
        <Border BackgroundColor="Black" Opacity="0.2"
                TranslationX="0" TranslationY="8" ZIndex="-1" StrokeShape="RoundRectangle 32" />
        
        <!-- Main card -->
        <Border x:Name="CardBorder" StrokeThickness="0" StrokeShape="RoundRectangle 32"
                Padding="28,24">
            <Border.Background>
                <LinearGradientBrush x:Name="GradientBrush" StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Offset="0" Color="#1a1a2e" />
                    <GradientStop Offset="0.5" Color="#6c5ce7" />
                    <GradientStop Offset="1" Color="#fd79a8" />
                </LinearGradientBrush>
            </Border.Background>

            <Grid RowDefinitions="Auto,*,Auto">
                <!-- Top: business name + logo -->
                <Grid ColumnDefinitions="*,Auto" Grid.Row="0" Margin="0,0,0,12">
                    <VerticalStackLayout>
                        <Label Text="LOYALTY" FontSize="17" FontAttributes="Bold"
                               TextColor="White" Opacity="0.6" />
                        <Label x:Name="BusinessNameLabel" Text="Business"
                               FontSize="34" FontAttributes="Bold" TextColor="White" />
                    </VerticalStackLayout>
                    
                <!-- Bussines icon/logo -->
                <Border Grid.Column="1" WidthRequest="60" HeightRequest="60"
                        BackgroundColor="White" StrokeShape="RoundRectangle 14"
                        HorizontalOptions="End" VerticalOptions="Center">
                    <Grid>
                        <Label x:Name="LogoPlaceholderLabel" Text="✦" FontSize="36" TextColor="White"
                               HorizontalOptions="Center" VerticalOptions="Center" />
                        <Image x:Name="LogoImage" Aspect="AspectFill" IsVisible="False" />
                    </Grid>
                </Border>
                </Grid>

                <!-- Center: QR code -->
                <Grid Grid.Row="1" HorizontalOptions="Center" VerticalOptions="Center">
                    <Border BackgroundColor="White" Padding="14" StrokeShape="RoundRectangle 24"
                            WidthRequest="320" HeightRequest="320">
                        <Image x:Name="QrCodeImage" Source="qr.png" Aspect="AspectFit" />
                    </Border>
                </Grid>

                <!-- Bottom: customer name + meta -->
                <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="0,12,0,0">
                    <VerticalStackLayout Grid.Column="0">
                        <Label Text="MEMBER" FontSize="22" FontAttributes="Bold"
                               TextColor="White" Opacity="0.5" />
                        <Label x:Name="CustomerNameLabel" Text="Customer"
                               FontSize="32" FontAttributes="Bold" TextColor="White" />
                        <Label x:Name="JoinedLabel" FontSize="19"
                               TextColor="White" Opacity="0.5" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Grid.Column="1" HorizontalOptions="End" WidthRequest="210">
                        <Label Text="ID" FontSize="16" FontAttributes="Bold"
                               TextColor="White" Opacity="0.4" HorizontalTextAlignment="End" />
                        <Label x:Name="CardIdLabel" FontSize="20" TextColor="White"
                               Opacity="0.6" FontFamily="Monospace" HorizontalTextAlignment="End" />
                    </VerticalStackLayout>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</ContentView>