<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:scanner="clr-namespace:BarcodeScanning;assembly=BarcodeScanning.Native.Maui"
             x:Class="munch_stamp.ScanVisitPage">

    <Grid RowDefinitions="Auto,*">

        <Label x:Name="InstructionsLabel" Grid.Row="0" Padding="15" HorizontalOptions="Center" />

        <scanner:CameraView x:Name="Scanner"
                            Grid.Row="1"
                            CameraEnabled="False"
                            VibrationOnDetected="True"
                            AimMode="True"
                            OnDetectionFinished="OnDetectionFinished" />

    </Grid>

</ContentPage>