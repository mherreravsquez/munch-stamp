<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:scanner="clr-namespace:BarcodeScanning;assembly=BarcodeScanning.Native.Maui"
             xmlns:controls="clr-namespace:munch_stamp.Controls"
             x:Class="munch_stamp.ScanVisitPage"
             BackgroundColor="{StaticResource BackgroundDark}">

    <Grid>
        <Grid RowDefinitions="Auto,*" Padding="20,16,20,100">
            <!-- Header -->
            <VerticalStackLayout Margin="0,0,0,12">
                <Label x:Name="ScanEyebrowLabel" TextColor="{StaticResource Primary}" FontSize="12" FontAttributes="Bold" />
                <Label x:Name="ScanTitleLabel" FontSize="28" FontAttributes="Bold" />
            </VerticalStackLayout>

            <!-- Scanner -->
            <Border Grid.Row="1" Padding="0" StrokeThickness="0" StrokeShape="RoundRectangle 22" BackgroundColor="{StaticResource GlassDark}">
                <Grid>
                    <!-- Camera (disabled by default) -->
                    <scanner:CameraView x:Name="Scanner"
                                        CameraEnabled="False"
                                        VibrationOnDetected="True"
                                        AimMode="False"
                                        OnDetectionFinished="OnDetectionFinished" />

                    <!-- Scan frame -->
                    <Border WidthRequest="240" HeightRequest="240" Stroke="{StaticResource Primary}" StrokeThickness="2" StrokeShape="RoundRectangle 22" BackgroundColor="Transparent" HorizontalOptions="Center" VerticalOptions="Center" />

                    <!-- Animated line -->
                    <BoxView x:Name="ScanLine" WidthRequest="220" HeightRequest="2" Color="{StaticResource Primary}" HorizontalOptions="Center" VerticalOptions="Center" />

                    <!-- Bottom text -->
                    <VerticalStackLayout VerticalOptions="End" Padding="24,20" Spacing="4" HorizontalOptions="Center">
                        <Label x:Name="ScanFrameHintLabel" FontAttributes="Bold" FontSize="16" HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </Grid>
            </Border>
        </Grid>

        <controls:FloatingTabBar x:Name="TabBar" />
    </Grid>
</ContentPage>
