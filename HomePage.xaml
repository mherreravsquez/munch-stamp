<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:converters="clr-namespace:munch_stamp.Converters"
             x:Class="munch_stamp.HomePage"
             BackgroundColor="{StaticResource BackgroundDark}">

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:InitialsConverter x:Key="InitialsConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Padding="20,16" Spacing="16">

            <!-- Header -->
            <Grid ColumnDefinitions="*,Auto">
                <VerticalStackLayout Spacing="2">
                    <Label x:Name="HomeEyebrowLabel" TextColor="{StaticResource Secondary}" FontSize="12" FontAttributes="Bold" />
                    <Label x:Name="HomeTitleLabel" FontSize="28" FontAttributes="Bold" />
                </VerticalStackLayout>
            </Grid>

            <!-- Hero -->
            <Border Padding="20" BackgroundColor="{StaticResource GlassDark}" Stroke="{StaticResource LineColor}" StrokeThickness="1" StrokeShape="RoundRectangle 24">
                <VerticalStackLayout Spacing="8">
                    <Label x:Name="HeroBrandLabel" FontAttributes="Bold" FontSize="16" />
                    <Label x:Name="HeroHeadlineLabel" FontSize="25" FontAttributes="Bold" LineBreakMode="WordWrap" />
                    <Label x:Name="HeroSubtitleLabel" TextColor="{StaticResource TextMuted}" FontSize="13" />
                </VerticalStackLayout>
            </Border>

            <!-- Statistics -->
            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                <Border Padding="16" BackgroundColor="{StaticResource GlassDark}" Stroke="{StaticResource LineColor}" StrokeThickness="1" StrokeShape="RoundRectangle 20">
                    <VerticalStackLayout>
                        <Label x:Name="ActiveCustomersValueLabel" FontSize="26" FontAttributes="Bold" />
                        <Label x:Name="ActiveCustomersLabelText" TextColor="{StaticResource TextMuted}" FontSize="11" />
                    </VerticalStackLayout>
                </Border>
                <Border Grid.Column="1" Padding="16" BackgroundColor="{StaticResource GlassDark}" Stroke="{StaticResource LineColor}" StrokeThickness="1" StrokeShape="RoundRectangle 20">
                    <VerticalStackLayout>
                        <Label x:Name="VisitsRecordedValueLabel" FontSize="26" FontAttributes="Bold" />
                        <Label x:Name="VisitsRecordedLabelText" TextColor="{StaticResource TextMuted}" FontSize="11" />
                    </VerticalStackLayout>
                </Border>
            </Grid>

            <!-- Recent activity -->
            <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                <Label x:Name="RecentActivityLabelText" FontAttributes="Bold" FontSize="15" />
                <Label Grid.Column="1" x:Name="ViewAllLabelText" TextColor="{StaticResource Secondary}" FontSize="12" />
            </Grid>

            <!-- Recent cards list (max 5) -->
            <CollectionView x:Name="CardsCollectionView" SelectionMode="Single" SelectionChanged="OnCardSelected" VerticalScrollBarVisibility="Never">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,0,10" Padding="16" BackgroundColor="{StaticResource GlassDark}" Stroke="{StaticResource LineColor}" StrokeThickness="1" StrokeShape="RoundRectangle 20">
                            <VerticalStackLayout Spacing="10">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                    <Border WidthRequest="43" HeightRequest="43" StrokeThickness="0" StrokeShape="RoundRectangle 14" BackgroundColor="{StaticResource Primary}">
                                        <Label Text="{Binding CustomerName, Converter={StaticResource InitialsConverter}}" FontAttributes="Bold" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                                    </Border>
                                    <VerticalStackLayout Grid.Column="1" Spacing="2">
                                        <Label Text="{Binding CustomerName}" FontAttributes="Bold" />
                                        <Label Text="{Binding ProgressText}" TextColor="{StaticResource TextMuted}" FontSize="12" />
                                    </VerticalStackLayout>
                                    <Label Grid.Column="2" Text="{Binding RewardDescription}" TextColor="#ffd1cc" FontSize="12" VerticalTextAlignment="Center" />
                                </Grid>
                                <ProgressBar Progress="{Binding ProgressPercent}" />
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>