<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:converters="clr-namespace:munch_stamp.Converters"
             xmlns:controls="clr-namespace:munch_stamp.Controls"
             x:Class="munch_stamp.HomePage"
             BackgroundColor="{StaticResource BackgroundDark}">

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:InitialsConverter x:Key="InitialsConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid>
        <ScrollView>
            <VerticalStackLayout Padding="20,16,20,110" Spacing="16">

                <!-- Header -->
                <Grid ColumnDefinitions="*,Auto">
                    <VerticalStackLayout Spacing="2">
                        <Label x:Name="HomeEyebrowLabel" TextColor="{StaticResource Primary}" FontSize="12" FontAttributes="Bold" />
                        <Label x:Name="HomeTitleLabel" FontSize="28" FontAttributes="Bold" />
                    </VerticalStackLayout>
                </Grid>

                <!-- Hero -->
                <Border Padding="20" BackgroundColor="{StaticResource GlassDark}" Stroke="{StaticResource LineColor}" StrokeThickness="1" StrokeShape="RoundRectangle 22">
                    <VerticalStackLayout Spacing="8">
                        <Label x:Name="HeroBrandLabel" TextColor="{StaticResource Primary}" FontAttributes="Bold" FontSize="16" />
                        <Label x:Name="HeroHeadlineLabel" FontSize="25" FontAttributes="Bold" LineBreakMode="WordWrap" />
                        <Label x:Name="HeroSubtitleLabel" TextColor="{StaticResource TextMuted}" FontSize="13" />
                    </VerticalStackLayout>
                </Border>

                <!-- Statistics -->
                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                    <Border Padding="16" BackgroundColor="{StaticResource GlassDark}" Stroke="{StaticResource LineColor}" StrokeThickness="1" StrokeShape="RoundRectangle 16">
                        <VerticalStackLayout>
                            <Label x:Name="ActiveCustomersValueLabel" FontSize="26" FontAttributes="Bold" />
                            <Label x:Name="ActiveCustomersLabelText" TextColor="{StaticResource TextMuted}" FontSize="11" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Column="1" Padding="16" BackgroundColor="{StaticResource GlassDark}" Stroke="{StaticResource LineColor}" StrokeThickness="1" StrokeShape="RoundRectangle 16">
                        <VerticalStackLayout>
                            <Label x:Name="VisitsRecordedValueLabel" FontSize="26" FontAttributes="Bold" />
                            <Label x:Name="VisitsRecordedLabelText" TextColor="{StaticResource TextMuted}" FontSize="11" />
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <!-- Recent activity -->
                <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                    <Label x:Name="RecentActivityLabelText" FontAttributes="Bold" FontSize="15" />
                    <Label Grid.Column="1" x:Name="ViewAllLabelText" TextColor="{StaticResource Primary}" FontSize="12" FontAttributes="Bold" />
                </Grid>

                <!-- Recent cards list (max 5) -->
                <CollectionView x:Name="CardsCollectionView" SelectionMode="Single" SelectionChanged="OnCardSelected" VerticalScrollBarVisibility="Never">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,8" Padding="14" BackgroundColor="{StaticResource GlassDark}" Stroke="{StaticResource LineColor}" StrokeThickness="1" StrokeShape="RoundRectangle 16">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                    <Border WidthRequest="42" HeightRequest="42" StrokeThickness="0" StrokeShape="RoundRectangle 12" BackgroundColor="{StaticResource AccentSoft}">
                                        <Label Text="{Binding CustomerName, Converter={StaticResource InitialsConverter}}" TextColor="{StaticResource Primary}" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                                    </Border>
                                    <VerticalStackLayout Grid.Column="1" Spacing="4">
                                        <Label Text="{Binding CustomerName}" FontAttributes="Bold" FontSize="14" />
                                        <Label Text="{Binding ProgressText}" TextColor="{StaticResource TextMuted}" FontSize="12" />
                                        <controls:StampDotsView Filled="{Binding VisitsCount}" Total="{Binding VisitsRequired}" HorizontalOptions="Start" />
                                    </VerticalStackLayout>
                                    <Label Grid.Column="2" Text="{Binding RewardDescription, StringFormat='🎁 {0}'}" TextColor="{StaticResource Primary}" FontSize="12" FontAttributes="Bold" VerticalTextAlignment="Center" HorizontalTextAlignment="End" MaximumWidthRequest="90" LineBreakMode="WordWrap" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

            </VerticalStackLayout>
        </ScrollView>

        <controls:FloatingTabBar x:Name="TabBar" />
    </Grid>
</ContentPage>
