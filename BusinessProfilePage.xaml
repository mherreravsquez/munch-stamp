<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="munch_stamp.BusinessProfilePage"
             Title="Business Profile">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">
            <HorizontalStackLayout Spacing="10">
                <Button Text="English" Clicked="OnEnglishClicked" />
                <Button Text="Español" Clicked="OnSpanishClicked" />
            </HorizontalStackLayout>
            
            <Label x:Name="BusinessNameLabelText" FontAttributes="Bold" />
            <Entry x:Name="NameEntry" />

            <Label x:Name="CategoryLabelText" FontAttributes="Bold" />
            <Entry x:Name="CategoryEntry" />

            <Label x:Name="VisitsRequiredLabelText" FontAttributes="Bold" />
            <HorizontalStackLayout Spacing="10">
                <Label x:Name="VisitsRequiredValueLabel" Text="10" VerticalOptions="Center" />
                <Stepper x:Name="VisitsRequiredStepper"
                         Minimum="1" Maximum="50" Value="10"
                         ValueChanged="OnVisitsRequiredChanged" />
            </HorizontalStackLayout>

            <Label x:Name="RewardLabelText" FontAttributes="Bold" />
            <Entry x:Name="RewardEntry" />

            <Button x:Name="SaveButton" Clicked="OnSaveClicked" Margin="0,20,0,0" />

            <Label x:Name="LanguageLabelText" FontAttributes="Bold" Margin="0,20,0,0" />
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>