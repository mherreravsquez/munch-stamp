<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="munch_stamp.BusinessProfilePage"
             Title="Business Profile">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">

            <Label Text="Business Name" FontAttributes="Bold" />
            <Entry x:Name="NameEntry" Placeholder="e.g. Munch Stamp Coffee" />

            <Label Text="Category" FontAttributes="Bold" />
            <Entry x:Name="CategoryEntry" Placeholder="e.g. Coffee shop" />

            <Label Text="Visits required for a reward" FontAttributes="Bold" />
            <HorizontalStackLayout Spacing="10">
                <Label x:Name="VisitsRequiredLabel" Text="10" VerticalOptions="Center" />
                <Stepper x:Name="VisitsRequiredStepper"
                         Minimum="1" Maximum="50" Value="10"
                         ValueChanged="OnVisitsRequiredChanged" />
            </HorizontalStackLayout>

            <Label Text="Reward description" FontAttributes="Bold" />
            <Entry x:Name="RewardEntry" Placeholder="e.g. Free coffee" />

            <Button Text="Save" Clicked="OnSaveClicked" Margin="0,20,0,0" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>