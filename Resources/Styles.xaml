<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- ===== BASE STYLES (coffee/copper theme) ===== -->
    <Style TargetType="Page" ApplyToDerivedTypes="True">
        <Setter Property="BackgroundColor" Value="{StaticResource BackgroundDark}" />
        <!-- Flat background now, matching the mockup (no wallpaper image).
             LoyaltyCardDetailPage still overrides BackgroundColor with its
             translucent scrim, same as before. -->
        <Setter Property="Padding" Value="0" />
    </Style>

    <Style TargetType="Shell">
        <Setter Property="BackgroundColor" Value="{StaticResource BackgroundDark}" />
        <Setter Property="ForegroundColor" Value="{StaticResource TextPrimary}" />
        <Setter Property="NavBarIsVisible" Value="False" />
        <!-- Native TabBar is hidden (Shell.TabBarIsVisible="False" in AppShell.xaml) —
             navigation between tabs is now handled by Controls/FloatingTabBar. -->
    </Style>

    <Style TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
        <Setter Property="FontFamily" Value="Inter, OpenSansRegular" />
        <Setter Property="FontSize" Value="14" />
    </Style>

    <!-- Style for Entry (text fields) -->
    <Style TargetType="Entry">
        <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
        <Setter Property="PlaceholderColor" Value="{StaticResource TextMuted}" />
        <Setter Property="BackgroundColor" Value="{StaticResource GlassSoft}" />
        <Setter Property="FontFamily" Value="Inter, OpenSansRegular" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="Opacity" Value="0.6" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <!-- Default "glass card" Border -->
    <Style TargetType="Border">
        <Setter Property="BackgroundColor" Value="{StaticResource GlassDark}" />
        <Setter Property="Stroke" Value="{StaticResource LineColor}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="StrokeShape" Value="RoundRectangle 22" />
        <Setter Property="Padding" Value="16" />
    </Style>

    <!-- Primary (solid accent) button -->
    <Style x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
        <Setter Property="TextColor" Value="{StaticResource AccentInk}" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="HeightRequest" Value="48" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Property="Scale" Value="0.97" />
                            <Setter Property="BackgroundColor" Value="{StaticResource AccentStrong}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <!-- Secondary (outline) button -->
    <Style x:Key="SecondaryButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{StaticResource GlassSoft}" />
        <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
        <Setter Property="BorderColor" Value="{StaticResource LineColor}" />
        <Setter Property="BorderWidth" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="HeightRequest" Value="48" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Property="Scale" Value="0.97" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <!-- ProgressBar kept for compatibility (still styled) even though the
         main loyalty-card screens now use Controls.StampDotsView instead. -->
    <Style TargetType="ProgressBar">
        <Setter Property="HeightRequest" Value="8" />
        <Setter Property="BackgroundColor" Value="{StaticResource BackgroundDeep}" />
        <Setter Property="ProgressColor" Value="{StaticResource Primary}" />
    </Style>

</ResourceDictionary>
