<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- ===== BASE DARK STYLES ===== -->
    <Style TargetType="Page" ApplyToDerivedTypes="True">
        <Setter Property="BackgroundColor" Value="{StaticResource BackgroundDark}" />
        <!-- Mesh-gradient wallpaper (generated to match the app's red/ochre
             palette — see gen_wallpaper.py). Applied here so every page
             gets it automatically; individual pages can override with
             BackgroundImageSource="{x:Null}" if they need a plain background
             (e.g. LoyaltyCardDetailPage's translucent modal scrim). -->
        <Setter Property="BackgroundImageSource" Value="wallpaper_bg.png" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <Style TargetType="Shell">
        <Setter Property="BackgroundColor" Value="{StaticResource BackgroundDark}" />
        <Setter Property="ForegroundColor" Value="{StaticResource TextPrimary}" />
        <Setter Property="NavBarIsVisible" Value="False" />
        <Setter Property="TabBarBackgroundColor" Value="#0f0507" />
        <Setter Property="TabBarForegroundColor" Value="{StaticResource Secondary}" />
        <Setter Property="TabBarTitleColor" Value="{StaticResource TextPrimary}" />
        <Setter Property="TabBarUnselectedColor" Value="#9e8581" />
    </Style>

    <Style TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
        <Setter Property="FontFamily" Value="Inter, OpenSansRegular" />
        <Setter Property="FontSize" Value="14" />
    </Style>

    <!-- Style for Entry (text fields) -->
    <Style TargetType="Entry">
        <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
        <Setter Property="PlaceholderColor" Value="{StaticResource TextMuted}" />
        <Setter Property="BackgroundColor" Value="{StaticResource BackgroundDark}" />
        <Setter Property="FontFamily" Value="Inter, OpenSansRegular" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="Opacity" Value="0.6" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <!-- Estilo para Border con efecto glass -->
    <Style TargetType="Border">
        <Setter Property="BackgroundColor" Value="{StaticResource GlassDark}" />
        <Setter Property="Stroke" Value="{StaticResource LineColor}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="StrokeShape" Value="RoundRectangle 24" />
        <Setter Property="Padding" Value="16" />
    </Style>

    <!-- Botón primario (relleno) -->
    <Style x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
        <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
        <Setter Property="CornerRadius" Value="15" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="HeightRequest" Value="48" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Property="Scale" Value="0.96" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <!-- Botón secundario (borde) -->
    <Style x:Key="SecondaryButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
        <Setter Property="BorderColor" Value="{StaticResource LineColor}" />
        <Setter Property="BorderWidth" Value="1" />
        <Setter Property="CornerRadius" Value="15" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="HeightRequest" Value="48" />
    </Style>

    <!-- ProgressBar -->
    <Style TargetType="ProgressBar">
        <Setter Property="HeightRequest" Value="8" />
        <Setter Property="BackgroundColor" Value="{StaticResource BackgroundDeep}" />
        <Setter Property="ProgressColor" Value="{StaticResource Primary}" />
    </Style>

</ResourceDictionary>
