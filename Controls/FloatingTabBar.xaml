<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="munch_stamp.Controls.FloatingTabBar"
             HorizontalOptions="Center"
             VerticalOptions="End"
             InputTransparent="False"
             Margin="0,0,0,20">

    <Border BackgroundColor="{StaticResource GlassSoft}"
            Stroke="{StaticResource LineColor}"
            StrokeThickness="1"
            StrokeShape="RoundRectangle 999"
            Padding="10,10"
            HorizontalOptions="Center"
            WidthRequest="340">
        <Border.Shadow>
            <Shadow Brush="Black" Opacity="0.45" Radius="30" Offset="0,10" />
        </Border.Shadow>

        <Grid ColumnDefinitions="*,*,*,*,*" ColumnSpacing="4" HorizontalOptions="Center" WidthRequest="300">

            <VerticalStackLayout x:Name="HomeTabItem" Grid.Column="0" Spacing="3" HorizontalOptions="Center">
                <Label x:Name="HomeTabIcon" Text="⌂" FontSize="20" HorizontalTextAlignment="Center" />
                <Label x:Name="HomeTabLabel" FontSize="12" FontAttributes="Bold" HorizontalTextAlignment="Center" />
                <VerticalStackLayout.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnHomeTapped" />
                </VerticalStackLayout.GestureRecognizers>
            </VerticalStackLayout>

            <VerticalStackLayout x:Name="CardsTabItem" Grid.Column="1" Spacing="3" HorizontalOptions="Center">
                <Label x:Name="CardsTabIcon" Text="▤" FontSize="20" HorizontalTextAlignment="Center" />
                <Label x:Name="CardsTabLabel" FontSize="12" FontAttributes="Bold" HorizontalTextAlignment="Center" />
                <VerticalStackLayout.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnCardsTapped" />
                </VerticalStackLayout.GestureRecognizers>
            </VerticalStackLayout>

            <VerticalStackLayout x:Name="ScanTabItem" Grid.Column="2" Spacing="3" HorizontalOptions="Center">
                <Label x:Name="ScanTabIcon" Text="⊡" FontSize="20" HorizontalTextAlignment="Center" />
                <Label x:Name="ScanTabLabel" FontSize="12" FontAttributes="Bold" HorizontalTextAlignment="Center" />
                <VerticalStackLayout.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnScanTapped" />
                </VerticalStackLayout.GestureRecognizers>
            </VerticalStackLayout>

            <VerticalStackLayout x:Name="BusinessTabItem" Grid.Column="3" Spacing="3" HorizontalOptions="Center">
                <Label x:Name="BusinessTabIcon" Text="▣" FontSize="20" HorizontalTextAlignment="Center" />
                <Label x:Name="BusinessTabLabel" FontSize="12" FontAttributes="Bold" HorizontalTextAlignment="Center" />
                <VerticalStackLayout.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnBusinessTapped" />
                </VerticalStackLayout.GestureRecognizers>
            </VerticalStackLayout>

            <VerticalStackLayout x:Name="BackupTabItem" Grid.Column="4" Spacing="3" HorizontalOptions="Center">
                <Label x:Name="BackupTabIcon" Text="⇧" FontSize="20" HorizontalTextAlignment="Center" />
                <Label x:Name="BackupTabLabel" FontSize="12" FontAttributes="Bold" HorizontalTextAlignment="Center" />
                <VerticalStackLayout.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnBackupTapped" />
                </VerticalStackLayout.GestureRecognizers>
            </VerticalStackLayout>

        </Grid>
    </Border>
</ContentView>
