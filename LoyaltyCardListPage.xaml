<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:converters="clr-namespace:munch_stamp.Converters"
             x:Class="munch_stamp.LoyaltyCardListPage"
             BackgroundColor="{StaticResource BackgroundDark}">

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:InitialsConverter x:Key="InitialsConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*" Padding="20,16">
        <!-- Header -->
        <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,12">
            <VerticalStackLayout Spacing="2">
                <Label Text="Fidelización" TextColor="{StaticResource Secondary}" FontSize="12" FontAttributes="Bold" />
                <Label Text="Tarjetas" FontSize="28" FontAttributes="Bold" />
            </VerticalStackLayout>
            <Border Grid.Column="1" WidthRequest="42" HeightRequest="42" Stroke="{StaticResource LineColor}" StrokeThickness="1" StrokeShape="RoundRectangle 15" Padding="0" HorizontalOptions="End" VerticalOptions="Center">
                <Label Text="＋" FontSize="24" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
            </Border>
        </Grid>

        <!-- List of all cards -->
        <CollectionView Grid.Row="1" x:Name="CardsCollectionView" SelectionMode="Single" SelectionChanged="OnCardSelected" VerticalScrollBarVisibility="Never">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Margin="0,0,0,10" Padding="16" BackgroundColor="{StaticResource GlassDark}" Stroke="{StaticResource LineColor}" StrokeThickness="1" StrokeShape="RoundRectangle 20">
                        <VerticalStackLayout Spacing="10">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                <Border WidthRequest="43" HeightRequest="43" StrokeThickness="0" StrokeShape="RoundRectangle 14" BackgroundColor="{StaticResource Primary}">
                                    <Label Text="{Binding CustomerName, Converter={StaticResource InitialsConverter}}" FontAttributes="Bold" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                                </Border>
                                <VerticalStackLayout Grid.Column="1" Spacing="2">
                                    <Label Text="{Binding CustomerName}" FontAttributes="Bold" />
                                    <Label Text="{Binding ProgressText}" TextColor="{StaticResource TextMuted}" FontSize="12" />
                                </VerticalStackLayout>
                                <Label Grid.Column="2" Text="{Binding RewardDescription}" TextColor="#ffd1cc" FontSize="12" VerticalTextAlignment="Center" />
                            </Grid>
                            <ProgressBar Progress="{Binding ProgressPercent}" />
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Floating add button (could be in footer) -->
        <Button Grid.Row="1" Style="{StaticResource PrimaryButton}" Text="＋ Añadir tarjeta" 
                VerticalOptions="End" Margin="0,0,0,12" Clicked="OnAddCardClicked" />
    </Grid>
</ContentPage>