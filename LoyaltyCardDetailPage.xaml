<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="munch_stamp.LoyaltyCardDetailPage"
             BackgroundColor="#80000000">

    <Border Margin="16,100,16,30" 
            BackgroundColor="{StaticResource GlassDark}"
            Stroke="{StaticResource LineColor}"
            StrokeThickness="1"
            StrokeShape="RoundRectangle 28"
            Padding="20">
        <VerticalStackLayout Spacing="16">

            <!-- Cabecera con botón cerrar -->
            <Grid ColumnDefinitions="*,Auto">
                <Label Text="Tarjeta de fidelización" TextColor="{StaticResource Secondary}" FontSize="12" FontAttributes="Bold" />
                <Button Grid.Column="1" Text="✕" BackgroundColor="Transparent" TextColor="{StaticResource TextMuted}" FontSize="18" Clicked="OnCloseClicked" />
            </Grid>

            <Label x:Name="CustomerNameLabel" FontSize="22" FontAttributes="Bold" />
            <Label x:Name="ProgressLabel" TextColor="{StaticResource TextMuted}" FontSize="14" />
            <Label x:Name="RewardLabel" TextColor="{StaticResource Secondary}" FontSize="14" FontAttributes="Bold" />

            <ProgressBar x:Name="ProgressBar" ProgressColor="{StaticResource Primary}" BackgroundColor="{StaticResource BackgroundDeep}" HeightRequest="8" />

            <Button Style="{StaticResource PrimaryButton}" Text="Registrar visita" Clicked="OnRegisterVisitClicked" />

            <Button Text="Cerrar" BackgroundColor="Transparent" TextColor="{StaticResource TextMuted}" Clicked="OnCloseClicked" />

        </VerticalStackLayout>
    </Border>
</ContentPage>