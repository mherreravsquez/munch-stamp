<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="munch_stamp.LoyaltyCardDetailPage"
             BackgroundColor="#80000000"
             BackgroundImageSource="{x:Null}">

    <Grid>
        <ContentView x:Name="CardRenderTarget"
                    IsVisible="False"
                    WidthRequest="600"
                    HeightRequest="840"
                    HorizontalOptions="Center"
                    VerticalOptions="Center" />

        <ScrollView>
            <Border Margin="16,60,16,30"
                   BackgroundColor="{StaticResource GlassDark}"
                   Stroke="{StaticResource LineColor}"
                   StrokeThickness="1"
                   StrokeShape="RoundRectangle 28"
                   Padding="20">

               <VerticalStackLayout Spacing="16">

                   <Grid ColumnDefinitions="*,Auto">
                       <Label x:Name="EyebrowLabel" TextColor="{StaticResource Secondary}" FontSize="12" FontAttributes="Bold" />
                       <Button Grid.Column="1" Text="✕" BackgroundColor="Transparent" TextColor="{StaticResource TextMuted}" FontSize="18" Clicked="OnCloseClicked" />
                   </Grid>

                   <Label x:Name="CustomerNameLabel" FontSize="22" FontAttributes="Bold" />
                   <Label x:Name="ProgressLabel" TextColor="{StaticResource TextMuted}" FontSize="14" />
                   <Label x:Name="RewardLabel" TextColor="{StaticResource Secondary}" FontSize="14" FontAttributes="Bold" />

                   <ProgressBar x:Name="ProgressBar" ProgressColor="{StaticResource Primary}" BackgroundColor="{StaticResource BackgroundDeep}" HeightRequest="8" />

                   <Image x:Name="QrCodeImage" HeightRequest="180" WidthRequest="180" HorizontalOptions="Center" BackgroundColor="White" Margin="0,8" />

                   <Button Style="{StaticResource PrimaryButton}" x:Name="RegisterVisitButtonControl" Clicked="OnRegisterVisitClicked" />

                   <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                       <Button Grid.Column="0" x:Name="ShareButton" BackgroundColor="{StaticResource GlassSoft}" Clicked="OnShareClicked" />
                       <Button Grid.Column="1" x:Name="UndoVisitButtonControl" BackgroundColor="{StaticResource GlassSoft}" Clicked="OnUndoVisitClicked" />
                   </Grid>

                   <Button x:Name="RedeemButton" IsVisible="False" Clicked="OnRedeemClicked" />

                   <Button x:Name="CloseButtonControl" BackgroundColor="Transparent" TextColor="{StaticResource TextMuted}" Clicked="OnCloseClicked" />

               </VerticalStackLayout>
            </Border>
        </ScrollView>
    </Grid>
</ContentPage>
